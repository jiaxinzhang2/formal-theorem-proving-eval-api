{
  "name": "demo-2026",
  "version": "2.0.0",
  "language": "lean4",
  "description": "Three frozen targets; answers export Submission.solution and may add arbitrary helpers.",
  "problem_count": 3,
  "toolchain": {
    "note": "Pin these so a result is reproducible. The grader records them in every run's run.json.",
    "lean": "leanprover/lean4:v4.15.0",
    "mathlib_rev": "unpinned-in-this-demo"
  },
  "conventions": {
    "problem_id": "file stem",
    "interface": "Submission.solution : Problem.Target"
  },
  "problems": {
    "P001": {
      "module": "Bench.P001",
      "gold_arguments": [
        "1"
      ]
    }
  },
  "policy": {
    "allowed_imports": [
      "Mathlib",
      "Std",
      "Batteries",
      "Init",
      "Lean",
      "Aesop"
    ],
    "allowed_axioms": [
      "propext",
      "Classical.choice",
      "Quot.sound"
    ],
    "allow_global_instances": true,
    "isolate_builds": true
  }
}
